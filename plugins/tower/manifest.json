{
  "id": "tower",
  "name": "The Tower",
  "version": "1.0.0",
  "description": "Race up a tower at night while the mist rises. Up to 8 players, five playstyles, punches and pick-ups.",
  "author": "KROWN",
  "tier": 1,
  "context": [
    "games"
  ],
  "url": "https://plugins.dissent.chat/plugins/tower/plugin.html",
  "declared_permissions": [],
  "allowed_fetch_domains": [],
  "config_schema": null,
  "categories": [
    "gaming"
  ],
  "sdk_version": "1",
  "game": {
    "api": 1,
    "placement": "over_chat",
    "players": [
      1,
      8
    ],
    "watchers": true,
    "drop_in": false,
    "blurb": "Race up the tower. Mind the mist.",
    "cover": "cover.png",
    "rounds": true,
    "settings": [
      {
        "key": "mode",
        "label": "Playstyle",
        "default": "race",
        "options": [
          {
            "value": "race",
            "label": "First to the top",
            "hint": "Race to the top floor. The mist puts you back a little."
          },
          {
            "value": "last",
            "label": "Last standing",
            "hint": "No top. The mist rises faster each time someone's out."
          },
          {
            "value": "chaos",
            "label": "Chaos",
            "hint": "Crates everywhere, and the strong pick-ups come up a lot."
          },
          {
            "value": "nohit",
            "label": "No hitting",
            "hint": "A clean race: no punches, only pick-ups that help you."
          },
          {
            "value": "koth",
            "label": "King of the hill",
            "hint": "Hold the crown on the top ledge for 60 seconds in total."
          }
        ]
      },
      {
        "key": "floors",
        "label": "Height",
        "default": 100,
        "hide_when": {
          "key": "mode",
          "is": [
            "last"
          ]
        },
        "options": [
          {
            "value": 50,
            "label": "Short · 50 floors"
          },
          {
            "value": 100,
            "label": "Medium · 100 floors"
          },
          {
            "value": 150,
            "label": "Long · 150 floors"
          }
        ]
      }
    ],
    "leaderboard": {
      "split_by": [
        "mode",
        "floors"
      ]
    }
  },
